# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# Screenshot diffs written next to the baselines on failure. The baselines
# themselves are committed — that is the point of them — but the artefacts of a
# failing comparison are noise in a diff.
/tests/visual/**/*-diff.png
/tests/visual/**/*-actual.png

# Vite / TS build info
*.tsbuildinfo
